# Never commit copyrighted material: disc images, BIOS dumps, extracted game
# files, or anything derived from them that contains the game's code or assets.
*.iso
*.ISO
*.bin
*.BIN
*.cue
*.img
extracted/
asm/
build/
bios/
/reference/
# PS2 BIOS dump files (ROM0, ROM1, NVM, MEC, DIFF)
*.ROM0
*.ROM1
*.NVM
*.MEC
*.DIFF
*.zip

# A game's own code in C++ - lifted, derived and reconstructed - is the game's,
# regenerated from the player's disc by the tools: never committed.
games/*/src/
games/*/overlays/*/src/
games/*/include/*/
!games/*/include/ps2/

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Editors / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# The disc image the CI fetches from the player's own Drive file, and what is
# unpacked from it (disc/).
disc/
