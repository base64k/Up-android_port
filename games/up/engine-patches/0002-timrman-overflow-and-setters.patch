index f075d93..fcb5c74 100644
--- a/host/src/iop_libs.cpp
+++ b/host/src/iop_libs.cpp
@@ -424,6 +424,48 @@ Outcome SetTimerHandler(Vm& vm, Context& c) {
     return Ret(c, KE_OK);
 }
 
+// SetTimerMode(id, mode): the mode as the module set it (kept; the timer's clock is
+// its source and prescale, set by SetupHardTimer).
+Outcome SetTimerMode(Vm& vm, Context& c) {
+    HardTimer* t = TimerOf(vm, c);
+    if (!t) return Ret(c, u32(KE_ILLEGAL_TIMERID));
+    t->mode = A(vm, c, 1);
+    return Ret(c, KE_OK);
+}
+
+// SetTimerCounter(id, count) / GetTimerCounter(id)
+Outcome SetTimerCounter(Vm& vm, Context& c) {
+    HardTimer* t = TimerOf(vm, c);
+    if (!t) return Ret(c, u32(KE_ILLEGAL_TIMERID));
+    t->counter = A(vm, c, 1);
+    return Ret(c, KE_OK);
+}
+
+Outcome GetTimerCounter(Vm& vm, Context& c) {
+    HardTimer* t = TimerOf(vm, c);
+    if (!t) return Ret(c, u32(KE_ILLEGAL_TIMERID));
+    return Ret(c, t->counter);
+}
+
+// SetTimerCompare(id, compare)
+Outcome SetTimerCompare(Vm& vm, Context& c) {
+    HardTimer* t = TimerOf(vm, c);
+    if (!t) return Ret(c, u32(KE_ILLEGAL_TIMERID));
+    t->compare = A(vm, c, 1);
+    return Ret(c, KE_OK);
+}
+
+// SetOverflowHandler(id, handler, common): the handler for the counter's overflow.
+// Stored; the overflow interrupt is not modelled (a module's compare handler is
+// what drives its timing).
+Outcome SetOverflowHandler(Vm& vm, Context& c) {
+    HardTimer* t = TimerOf(vm, c);
+    if (!t) return Ret(c, u32(KE_ILLEGAL_TIMERID));
+    t->overflow = A(vm, c, 1);
+    t->overflow_common = A(vm, c, 2);
+    return Ret(c, KE_OK);
+}
+
 // SetupHardTimer(id, source, mode, prescale)
 Outcome SetupHardTimer(Vm& vm, Context& c) {
     HardTimer* t = TimerOf(vm, c);
@@ -1328,7 +1370,9 @@ const Map& Table() {
