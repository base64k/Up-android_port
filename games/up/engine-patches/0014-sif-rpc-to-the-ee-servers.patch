+// ------------------------------------------------ the EE's servers, for the IOP
+// A bind or call the IOP makes of a server the EE registered goes to the EE as
+// a packet, and the EE's own sifrpc answers it (ps2sdk's _request_bind and
+// _request_call): the answer is an RPC-end packet (0x80000008) that comes back
+// through EeRpcEnd. The IOP's client waits for it, as the library's bind and
+// call do.
+namespace {
+
+// The IOP clients waiting for the EE, by client (SifRpcClientData_t).
+std::map<u32, RpcRequest>& EeRequests() {
+    static std::map<u32, RpcRequest> requests;
+    return requests;
+}
+
+// SifRpcClientData_t: hdr (pkt_addr, rpc_id, sema_id, mode), command, buf,
+// cbuf, end_function, end_param, server.
+constexpr u32 kEeClientBuf = 20, kEeClientCbuf = 24, kEeClientServer = 36;
+// The EE's request commands; its RPC-end (0x80000008) answers them (SifRpcRendPkt_t).
+constexpr u32 kEeBindCommand = 0x80000009u, kEeCallCommand = 0x8000000Au;
+
+void PutEeWord(std::vector<u8>& bytes, std::size_t at, u32 value) {
+    std::memcpy(bytes.data() + at, &value, 4);
+}
+
+u32 EeWord(const std::vector<u8>& bytes, std::size_t at) {
+    u32 value = 0;
+    if (at + 4 <= bytes.size()) std::memcpy(&value, bytes.data() + at, 4);
+    return value;
+}
+
+// The EE's bind and call traffic, in order: each line as "[host]" (the report
+// keeps those), a few dozen of them - Note would keep only the first of each.
+void EeLog(const char* text) {
+    static int logged = 0;
+    if (logged++ < 60) std::fprintf(stderr, "[host] %s\n", text);
+}
+
+// A request for the EE: 64 bytes, its size and command in the header, then the
+// client (cd) the EE echoes back in its answer.
+std::vector<u8> EeRequestPacket(u32 command, u32 client) {
+    std::vector<u8> packet(0x40, 0);
+    PutEeWord(packet, 0, 0x40);         // packet size; no extra data
+    PutEeWord(packet, 8, command);
+    PutEeWord(packet, 20, client);      // pkt_addr: echoed back, not used
+    PutEeWord(packet, 28, client);      // cd: the IOP's client
+    return packet;
+}
+
+}  // namespace
+
+void SendEeBind(u32 client, u32 sid, bool blocking) {
+    Vm& vm = TheVm();
+    RpcRequest request;
+    request.iop_client = true;
+    request.blocking = blocking;
+    request.client = vm.current;
+    EeRequests()[client] = request;
+    char text[128];
+    std::snprintf(text, sizeof text, "IOP: binds RPC 0x%08X on the EE (client 0x%08X)", unsigned(sid), unsigned(client));
+    EeLog(text);
+    std::vector<u8> packet = EeRequestPacket(kEeBindCommand, client);
+    PutEeWord(packet, 32, sid);         // sid
+    QueueIopPacket(std::move(packet));
+}
+
+void SendEeCall(u32 client, u32 server, u32 procedure, u32 send, u32 size, u32 receive,
+                u32 receive_size, bool blocking, u32 end_function, u32 end_param, u32 client_gp) {
+    Vm& vm = TheVm();
+    // The arguments go where the EE's server takes them: its buffer, from the
+    // bind (the library DMAs them there).
+    const u32 buffer = vm.Read(client + kEeClientBuf, 4);
+    if (size && buffer) {
+        std::vector<u8> bytes(size);
+        for (u32 i = 0; i < size; ++i) bytes[i] = u8(vm.Read(send + i, 1));
+        GuestMemory().WriteBytes(buffer, bytes.data(), size);
+    }
+    RpcRequest request;
+    request.server = server;
+    request.procedure = procedure;
+    request.size = size;
+    request.receive = receive;
+    request.receive_size = receive_size;
+    request.iop_client = true;
+    request.blocking = blocking;
+    request.client = vm.current;
+    request.client_gp = client_gp;
+    request.end_function = end_function;
+    request.end_param = end_param;
+    EeRequests()[client] = request;
+    char text[160];
+    std::snprintf(text, sizeof text, "IOP: RPC procedure %u on the EE (%u bytes in, %u out, client 0x%08X)",
+                  unsigned(procedure), unsigned(size), unsigned(receive_size), unsigned(client));
+    EeLog(text);
+    std::vector<u8> packet = EeRequestPacket(kEeCallCommand, client);
+    PutEeWord(packet, 32, procedure);   // rpc_number
+    PutEeWord(packet, 36, size);        // send_size
+    // recvbuf: the EE answers its data there (none without a buffer to take it).
+    PutEeWord(packet, 40, receive);
+    PutEeWord(packet, 44, receive ? receive_size : 0);
+    PutEeWord(packet, 48, 1);           // rmode: the answer's data comes with its packet
+    PutEeWord(packet, 52, server);      // sd: the EE's server, from the bind
+    QueueIopPacket(std::move(packet));
+}
+
+void EeRpcEnd(const std::vector<u8>& packet) {
+    Vm& vm = TheVm();
+    const u32 client = EeWord(packet, 28), answered = EeWord(packet, 32);
+    const auto found = EeRequests().find(client);
+    if (found == EeRequests().end()) {
+        char text[128];
+        std::snprintf(text, sizeof text, "IOP: the EE answered command 0x%08X for no IOP client (0x%08X)",
+                      unsigned(answered), unsigned(client));
+        EeLog(text);
+        return;
+    }
+    const RpcRequest done = found->second;
+    EeRequests().erase(found);
+    if (answered == kEeBindCommand) {
+        // SifRpcRendPkt_t: sd (36), buf (40), cbuf (44). The server is the EE's
+        // sd, which the call names; NULL: no server is registered for the sid yet.
+        const u32 server = EeWord(packet, 36), buffer = EeWord(packet, 40), cbuffer = EeWord(packet, 44);
+        vm.Write(client + kEeClientBuf, buffer, 4);
+        vm.Write(client + kEeClientCbuf, cbuffer, 4);
+        vm.Write(client + kEeClientServer, server, 4);
+        char text[128];
+        std::snprintf(text, sizeof text, "IOP: the EE's bind answer: server 0x%08X (client 0x%08X)",
+                      unsigned(server), unsigned(client));
+        EeLog(text);
+        if (!server && done.blocking) {
+            // Not yet: the caller's loop asks again in a millisecond, not at once,
+            // so the EE runs in the meantime.
+            auto caller = vm.threads.find(done.client);
+            if (caller != vm.threads.end() && caller->second.wait == Wait::RpcReply) {
+                caller->second.wait = Wait::Delay;
+                caller->second.object = 0;
+                caller->second.until_us = vm.NowUs() + 1000;
+                return;
+            }
+        }
+        if (done.blocking) WakeRpcCaller(vm, done.client);
+        return;
+    }
+    if (answered == kEeCallCommand) {
+        // Its data is in the IOP's buffer already (the EE DMA'd it there).
+        char text[128];
+        std::snprintf(text, sizeof text, "IOP: the EE answered the call of client 0x%08X", unsigned(client));
+        EeLog(text);
+        IopRpcAnswer(vm, done, 0);
+        return;
+    }
+}
+
 u32 Allocate(u32 size) { return TheVm().Allocate(size); }
 void Free(u32 address) { TheVm().Free(address); }
 
