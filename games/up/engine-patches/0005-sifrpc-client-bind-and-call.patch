+                  unsigned(entry.sid), unsigned(request.procedure), unsigned(request.size),
+                  unsigned(request.receive_size));
+    Note("iop rpc call " + std::to_string(entry.sid) + " " + std::to_string(request.procedure), text);
+    vm.rpc_pending[entry.queue].push_back(queued);
+    auto thread = vm.rpc_queues.find(entry.queue);
