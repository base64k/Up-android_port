+// The IOP's SIF RPC client, as ps2sdk's IOP library has it (sifrpc.c). The
+// SifRpcClientData_t: hdr (pkt_addr, rpc_id, sema_id, mode: 16 bytes), command,
+// buf, cbuf, end_function, end_param, server (at 36).
+constexpr u32 kClientCommand = 16, kClientBuf = 20, kClientCbuf = 24, kClientServer = 36;
+constexpr u32 kSifRpcNoWait = 1;
+
+// sceSifBindRpc(client, sid, mode): the client takes the server a module
+// registered for `sid`; with none, server stays NULL and the caller waits
+// for one (the bind returns 0 either way, as the library's does).
+Outcome SifBindRpcClient(Vm& vm, Context& c) {
+    const u32 client = A(vm, c, 0), sid = A(vm, c, 1);
+    u32 server = 0, buffer = 0, cbuffer = 0;
+    for (const auto& [address, entry] : vm.rpc_servers)
+        if (entry.sid == sid) {
+            server = address;
+            buffer = entry.buffer;
+            cbuffer = entry.cbuffer;
+            break;
+        }
+    vm.Write(client + kClientCommand, 0, 4);
+    vm.Write(client + kClientBuf, buffer, 4);
+    vm.Write(client + kClientCbuf, cbuffer, 4);
+    vm.Write(client + kClientServer, server, 4);
+    return Ret(c, 0);
+}
+
+// sceSifCallRpc(client, procedure, mode, send, ssize, recv, rsize, end, end_param).
+// A blocking call waits for the answer (its thread is woken from the server's);
+// the end function runs when the answer is in, as the library runs it.
+Outcome SifCallRpcClient(Vm& vm, Context& c) {
+    const u32 client = A(vm, c, 0), procedure = A(vm, c, 1), mode = A(vm, c, 2);
+    const u32 send = A(vm, c, 3), ssize = A(vm, c, 4), recv = A(vm, c, 5), rsize = A(vm, c, 6);
+    const u32 end_function = A(vm, c, 7), end_param = A(vm, c, 8);
+    const u32 server = vm.Read(client + kClientServer, 4);
+    const auto entry = vm.rpc_servers.find(server);
+    if (!server || entry == vm.rpc_servers.end()) return Ret(c, u32(-1));    // not bound
+    for (u32 i = 0; i < ssize; ++i) vm.Write(entry->second.buffer + i, vm.Read(send + i, 1), 1);
+    RpcRequest request;
+    request.procedure = procedure;
+    request.size = ssize;
+    request.receive = recv;
+    request.receive_size = rsize;
+    request.iop_client = true;
+    request.blocking = !(mode & kSifRpcNoWait);
+    request.client = vm.current;
+    request.client_gp = c.r[28];
+    request.end_function = end_function;
+    request.end_param = end_param;
+    IopRpcCall(vm, server, request);
+    if (!request.blocking) return Ret(c, 0);
+    if (!vm.Block(c, Wait::RpcReply, client)) return Ret(c, u32(KE_CAN_NOT_WAIT));
+    return Outcome::Block;
+}
 
