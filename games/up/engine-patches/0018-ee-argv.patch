 }
 
+// The arguments the kernel gives a program at SetupThread: a struct sargs at `args`
+// (argc, argv[16], payload[256]), which the start-up code (crt0) hands to main. argc = 1 and
+// argv[0] = the program's own path (cdrom0:\NAME;1), kept in the payload.
+static void WriteProgramArgs(u32 args) {
+    constexpr u32 kArgv = 4, kPayload = 4 + 16 * 4, kPayloadSize = 256;
+    Memory& m = GuestMemory();
+    u8* block = m.Translate(args, kPayload + kPayloadSize);
+    if (!block) return;
+    const std::size_t n = std::min<std::size_t>(g_program_path.size(), kPayloadSize - 1);
+    std::memset(block, 0, kPayload + kPayloadSize);
+    std::memcpy(block + kPayload, g_program_path.data(), n);
+    const u32 argc = 1, argv0 = args + kPayload;
+    std::memcpy(block, &argc, 4);
+    std::memcpy(block + kArgv, &argv0, 4);
+    std::fprintf(stderr, "[host] SetupThread: program args at %08X (argc 1, argv[0] \"%s\")\n", unsigned(args), g_program_path.c_str());
+}
+
 void KernelSyscall(lifted::Context& c) {
     const s32 service = s32(u32(c.r[3]));
     const s32 number = service < 0 ? -service : service;
