+// strtok(s, delim): the C library's token scanner; its position is kept between
+// calls (s null: go on from the last token).
+Outcome Strtok(Vm& vm, Context& c) {
+    u32 s = A(vm, c, 0);
+    const std::string delim = vm.String(A(vm, c, 1), 256);
+    if (!s) s = vm.strtok_next;
+    if (!s) return Ret(c, 0);
+    auto is_delim = [&](u32 ch) { return delim.find(char(ch)) != std::string::npos; };
+    for (;;) {                                   // skip the delimiters ahead of the token
+        const u32 ch = vm.Read(s, 1);
+        if (!ch) { vm.strtok_next = 0; return Ret(c, 0); }
+        if (!is_delim(ch)) break;
+        ++s;
+    }
+    const u32 token = s;
+    for (;;) {                                   // the token's end
+        const u32 ch = vm.Read(s, 1);
+        if (!ch) { vm.strtok_next = 0; break; }
+        if (is_delim(ch)) {
+            vm.Write(s, 0, 1);
+            vm.strtok_next = s + 1;
+            break;
+        }
+        ++s;
+    }
+    return Ret(c, token);
+}
