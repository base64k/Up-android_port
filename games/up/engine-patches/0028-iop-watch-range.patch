+// Diagnostic (PS2HOST_IOP_WATCH=LO-HI, IOP addresses in hex): each byte of that
+// range that changed since the last scheduling point is kept (the last 2000) and
+// printed when the IOP stops on a bad instruction, with the thread that ran last
+// and its last instruction. A change made by a DMA (the EE's SIF transfers) comes
+// in between those, so the last instruction shows where it was when it was seen.
+void WatchIopRange(Vm& vm) {
+    static bool checked = false, armed = false;
+    static u32 lo = 0, size = 0;
+    static std::vector<u8> seen;
+    if (!checked) {
+        checked = true;
+        unsigned a = 0, b = 0;
+        const char* env = std::getenv("PS2HOST_IOP_WATCH");
+        if (env && std::sscanf(env, "%x-%x", &a, &b) == 2 && b > a) {
+            lo = a;
+            size = b - a;
+            if (const u8* p = vm.At(lo, size)) {
+                seen.assign(p, p + size);
+                armed = true;
+            }
+        }
+    }
+    if (!armed) return;
+    const u8* p = vm.At(lo, size);
+    if (!p) return;
+    for (u32 i = 0; i < size; ++i) {
+        if (p[i] == seen[i]) continue;
+        char line[160];
+        std::snprintf(line, sizeof line, "[iopwatch] %08X: %02X -> %02X, thread %u, last instruction %08X, at %llu us",
+                      unsigned(lo + i), unsigned(seen[i]), unsigned(p[i]), unsigned(vm.current),
+                      unsigned(vm.executing), static_cast<unsigned long long>(vm.NowUs()));
+        std::deque<std::string>& ring = IopWatchRing();
+        ring.emplace_back(line);
+        if (ring.size() > 2000) ring.pop_front();
+        seen[i] = p[i];
+    }
+}
