+// ReferThreadStatus(id, info): the thread's status. The host keeps no thread status to
+// give, so the info block is zeros (a module reading it sees no thread in any state).
+Outcome ReferThreadStatusZero(Vm& vm, Context& c) {
+    const u32 info = A(vm, c, 1);
+    if (info)
+        for (u32 i = 0; i < 0x30; i += 4) vm.Write(info + i, 0, 4);
+    return Ret(c, KE_OK);
+}
