diff --git a/host/src/loadfile.cpp b/host/src/loadfile.cpp
index 1097e74..b3a8963 100644
--- a/host/src/loadfile.cpp
+++ b/host/src/loadfile.cpp
@@ -150,7 +150,21 @@ std::vector<u8> LoadFile(u32 procedure, const std::vector<u8>& data) {
         const std::string path(begin, strnlen(begin, 252));
         const s32 id = next_id++;
         Loaded().push_back({NameFromPath(path), id});
-        if (iop::RunsModule(path)) return RunFromDisc(id, path, data);
+        if (iop::RunsModule(path)) {
+            // The sound driver's own module (SDRDRV.IRX) comes first, and the EE never loads
