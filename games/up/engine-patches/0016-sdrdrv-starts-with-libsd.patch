+            // when the EE loads the library it belongs with (LIBSD.IRX), and only once.
+            static bool sound_driver_started = false;
+            if (!sound_driver_started && NameFromPath(path) == "libsd" && iop::RunsModule("SDRDRV.IRX")) {
+                sound_driver_started = true;
+                const std::string driver = "cdrom0:\\MODULES\\SDRDRV.IRX;1";
+                const std::vector<u8> no_args(0x104, 0);
+                const s32 driver_id = next_id++;
+                Loaded().push_back({NameFromPath(driver), driver_id});
+                RunFromDisc(driver_id, driver, no_args);
+            }
+            return RunFromDisc(id, path, data);
+        }
         Note("module " + path, "IOP: module " + path + " loaded as " + std::to_string(id) +
                                    " (its services are the host's)");
         return Words(id, kResidentEnd);
