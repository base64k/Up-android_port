+// CRC-32 (the zlib/PNG polynomial): the same value a checker gets from zlib.crc32.
+static u32 Crc32(const u8* p, std::size_t n) {
+    static u32 table[256];
+    static bool made = false;
+    if (!made) {
+        for (u32 i = 0; i < 256; ++i) {
+            u32 c = i;
+            for (int k = 0; k < 8; ++k) c = (c & 1) ? 0xEDB88320u ^ (c >> 1) : c >> 1;
+            table[i] = c;
+        }
+        made = true;
+    }
+    u32 crc = 0xFFFFFFFFu;
+    for (std::size_t i = 0; i < n; ++i) crc = table[(crc ^ p[i]) & 0xFF] ^ (crc >> 8);
+    return ~crc;
+}
+
+// Every read of the disc, with the CRC-32 of the 2048-byte sectors it gave.
+// scripts/disc_crc_check.py compares each with the same sectors of the image.
 bool Disc::Read(u32 lsn, u32 count, u8* out) {
+    const bool ok = ReadUnlogged(lsn, count, out);
+    if (ok) std::fprintf(stderr, "[disc] read lsn %u count %u crc %08X\n", lsn, count,
+                         Crc32(out, std::size_t(count) * kSectorSize));
+    return ok;
+}
