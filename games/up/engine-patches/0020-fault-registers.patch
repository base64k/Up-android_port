+/* A diagnostic for a fault (a read or write outside guest memory): the thread
+   that was running, its entry and its general registers, as the translated code
+   left them in its context. */
+void ReportRunningRegisters() {
+    Scheduler& s = S();
+    if (!s.current) {
+        std::fprintf(stderr, "[regs] no thread was running\n");
+        return;
+    }
+    const lifted::Context& c = s.current->context;
+    std::fprintf(stderr, "[regs] thread %u, entry %08X\n", unsigned(s.current->id), unsigned(s.current->entry));
+    for (int i = 0; i < 32; i += 2)
+        std::fprintf(stderr, "[regs] r%02d %016llX   r%02d %016llX\n", i, (unsigned long long)c.r[i],
+                     i + 1, (unsigned long long)c.r[i + 1]);
+    std::fflush(stderr);
+}
