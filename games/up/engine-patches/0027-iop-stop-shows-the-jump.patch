 namespace {
 
+// What a stop on a bad instruction shows: the instruction that jumped there (the
+// one run before it) and the registers of the thread that ran it. A word that is
+// data (here 0x00000001 in an IOP buffer) means a jump to a stale or wrong address.
+std::string JumpInfo(Vm& vm, const Context& c) {
+    std::string s = " (after the instruction at " + Hex(vm.previous_executing) + " = " +
+                    Hex(vm.Read(vm.previous_executing, 4)) + "; registers";
+    for (int i = 0; i < 32; ++i) s += (i % 8 == 0 ? "\n  r" : " r") + std::to_string(i) + "=" + Hex(c.r[i]);
+    return s + " hi=" + Hex(c.hi) + " lo=" + Hex(c.lo) + ")";
+}
+
