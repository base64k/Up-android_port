+// VK_ERROR_SURFACE_LOST_KHR: the surface is gone (Android took the window away, the screen was
+// turned in a way the driver cannot follow). The surface and the swapchain are made again from the
+// window; until then the pictures are not shown, and the display goes on (it did not, before:
+// the first lost picture ended the game's screen).
+bool VulkanDisplay::RecreateSurface() {
+    DestroySwapchain();
+    if (surface_) vkDestroySurfaceKHR(instance_, surface_, nullptr);
+    surface_ = VK_NULL_HANDLE;
+    if (!SDL_Vulkan_CreateSurface(window_, instance_, nullptr, &surface_)) {
+        std::fprintf(stderr, "[display] the surface not made again yet: %s\n", SDL_GetError());
+        surface_ = VK_NULL_HANDLE;
+        return false;
+    }
+    std::fprintf(stderr, "[display] the surface made again\n");
+    surface_lost_ = false;
+    stale_ = true;
+    return true;
+}
