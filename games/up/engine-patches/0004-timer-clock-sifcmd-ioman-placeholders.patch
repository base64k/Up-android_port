     HardTimer* t = TimerOf(vm, c);
     if (!t) return Ret(c, u32(KE_ILLEGAL_TIMERID));
     t->counter = A(vm, c, 1);
+    t->started_us = vm.NowUs();
     return Ret(c, KE_OK);
 }
 
+// GetTimerCounter(id): the count - from the set value, rising one a microsecond
+// while the timer runs (a module polls it to time a wait).
 Outcome GetTimerCounter(Vm& vm, Context& c) {
     HardTimer* t = TimerOf(vm, c);
     if (!t) return Ret(c, u32(KE_ILLEGAL_TIMERID));
-    return Ret(c, t->counter);
+    const u32 now = t->running ? t->counter + u32(vm.NowUs() - t->started_us) : t->counter;
+    return Ret(c, now);
 }
 
 // SetTimerCompare(id, compare)
@@ -479,6 +483,7 @@ Outcome StartHardTimer(Vm& vm, Context& c) {
     HardTimer* t = TimerOf(vm, c);
     if (!t) return Ret(c, u32(KE_ILLEGAL_TIMERID));
     t->running = true;
+    t->started_us = vm.NowUs();
     t->due_us = vm.NowUs() + HardTimerPeriodUs(*t);
     return Ret(c, KE_OK);
 }
@@ -486,6 +491,7 @@ Outcome StartHardTimer(Vm& vm, Context& c) {
 Outcome StopHardTimer(Vm& vm, Context& c) {
