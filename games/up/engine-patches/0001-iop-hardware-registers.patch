     return " (IOP thread " + std::to_string(current) + ", $ra " + Hex(threads[current].c.r[31]) + ")";
 }
 
+u32 Vm::HardwareRead(u32 address, u32 size) {
+    u32 value = 0;
+    for (u32 i = 0; i < size && i < 4; ++i) {
+        const auto it = hardware.find(address + i);
+        if (it != hardware.end()) value |= u32(it->second) << (8 * i);
+    }
+    return value;
+}
+
+void Vm::HardwareWrite(u32 address, u32 value, u32 size) {
+    for (u32 i = 0; i < size && i < 4; ++i) hardware[address + i] = u8(value >> (8 * i));
+}
+
 void Vm::ReadFault(u32 address) {
     Stop("a read of " + Hex(address) + " (IOP hardware or unmapped), by the instruction at " + Hex(executing) +
          Where());
diff --git a/host/src/iop_vm_internal.h b/host/src/iop_vm_internal.h
index 643a5e4..d366c37 100644
--- a/host/src/iop_vm_internal.h
